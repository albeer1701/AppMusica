<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="36dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="134dp"
            android:layout_height="58dp"
            android:contentDescription="Logo YourTune"
            android:scaleType="fitStart"
            android:src="@drawable/yourtunelogotwo" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/profileIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button_outline"
            android:contentDescription="Cuenta"
            android:padding="3dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/foto_perfil" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selected"
            android:contentDescription="Inicio"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logoyellow" />

        <Button
            android:id="@+id/navSongs"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selected"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Canciones"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navAlbums"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selected"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Álbumes"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selected"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Perfil"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <EditText
        android:id="@+id/etSearchAlbums"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:hint="Buscar álbumes..."
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:textColorHint="#A7B6C2"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAlbums"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="true" />

</LinearLayout>