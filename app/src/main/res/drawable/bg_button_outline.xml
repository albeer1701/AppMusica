<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#274C77"/>
            <stroke
                android:width="1dp"
                android:color="#AFCBFF"/>
            <corners android:radius="12dp"/>
            <padding
                android:left="6dp"
                android:top="6dp"
                android:right="6dp"
                android:bottom="6dp"/>
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#1F3B5B"/>
            <stroke
                android:width="1dp"
                android:color="#8FB8FF"/>
            <corners android:radius="12dp"/>
            <padding
                android:left="6dp"
                android:top="6dp"
                android:right="6dp"
                android:bottom="6dp"/>
        </shape>
    </item>

</selector>